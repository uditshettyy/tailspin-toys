---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6 shadow-lg" data-testid="games-filters-panel">
      <form method="get" action="/" class="space-y-6" data-testid="game-filters-form">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end">
          <fieldset class="flex-1" data-testid="category-filters">
            <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-slate-500"
                  data-testid={`category-filter-label-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="lg:w-72">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900/70 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex items-center justify-between gap-3">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>

          <a
            href="/"
            class="text-sm font-medium text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-md px-2 py-1"
            data-testid="clear-filters-link"
          >
            Clear filters
          </a>
        </div>
      </form>
    </div>

    <div>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="game-results-count">{games.length} game{games.length === 1 ? '' : 's'}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <div data-testid="empty-state-wrapper" class="hidden">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  const filterForm = document.querySelector('[data-testid="game-filters-form"]');
  const clearFiltersLink = document.querySelector('[data-testid="clear-filters-link"]');
  const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
  const resultCount = document.querySelector('[data-testid="game-results-count"]');
  const gamesGrid = document.querySelector('[data-testid="games-grid"]');
  const emptyStateWrapper = document.querySelector('[data-testid="empty-state-wrapper"]');
  const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));

  function applyFilters() {
    const selectedCategories = Array.from(
      document.querySelectorAll('[data-testid^="category-filter-"]:checked'),
    ).map((checkbox) => Number(checkbox.value));
    const selectedPublisher = publisherFilter?.value ? Number(publisherFilter.value) : null;
    const hasActiveFilters = selectedCategories.length > 0 || selectedPublisher !== null;

    let visibleCount = 0;
    for (const card of gameCards) {
      const cardCategory = Number(card.dataset.categoryId || 0);
      const cardPublisher = Number(card.dataset.publisherId || 0);
      const categoryMatch = selectedCategories.length === 0 || selectedCategories.includes(cardCategory);
      const publisherMatch = selectedPublisher === null || cardPublisher === selectedPublisher;
      const isVisible = categoryMatch && publisherMatch;
      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    }

    const url = new URL(window.location.href);
    url.searchParams.delete('category');
    url.searchParams.delete('publisher');

    for (const categoryId of selectedCategories) {
      url.searchParams.append('category', String(categoryId));
    }

    if (selectedPublisher !== null) {
      url.searchParams.set('publisher', String(selectedPublisher));
    }

    window.history.replaceState({}, '', url);

    gamesGrid.classList.toggle('hidden', visibleCount === 0);
    emptyStateWrapper.classList.toggle('hidden', visibleCount !== 0);
    resultCount.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    clearFiltersLink.classList.toggle('hidden', !hasActiveFilters);
  }

  function syncInputsFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = params.getAll('category');
    const selectedPublisher = params.get('publisher');

    for (const categoryValue of selectedCategories) {
      const checkbox = document.querySelector(`[data-testid="category-filter-${categoryValue}"]`);
      if (checkbox) {
        checkbox.checked = true;
      }
    }

    if (selectedPublisher && publisherFilter) {
      publisherFilter.value = selectedPublisher;
    }
  }

  if (filterForm) {
    filterForm.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
  }

  if (clearFiltersLink) {
    clearFiltersLink.addEventListener('click', (event) => {
      event.preventDefault();
      for (const checkbox of document.querySelectorAll('[data-testid^="category-filter-"]')) {
        checkbox.checked = false;
      }
      if (publisherFilter) {
        publisherFilter.value = '';
      }
      applyFilters();
      window.history.replaceState({}, '', '/');
    });
  }

  syncInputsFromUrl();
  applyFilters();
</script>
